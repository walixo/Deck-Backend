# Server
PORT=4200
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/deck

# Auth
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS — comma separated list of allowed origins
CLIENT_ORIGIN=http://localhost:5173

# Payments — Paystack
# Secret key is server-only and must never reach the browser.
PAYSTACK_SECRET_KEY=sk_test_replace_me

# Deck's cut of merch sales and fundraise contributions, as a percentage.
# Charged on goods only -- shipping is passed through to the seller in full.
# 0 means sellers and launchers keep everything. The fee is calculated and
# recorded either way, so switching it on later needs no backfill.
# Clamped to 0-50 in code, so a typo cannot swallow someone's payout.
PLATFORM_FEE_PERCENT=0

# Fundraise bounds, in minor units of CURRENCY (kobo for NGN).
# Defaults: a floor of NGN 1,000 and a ceiling of NGN 5,000,000 per contribution.
MIN_CONTRIBUTION_MINOR=100000
MAX_CONTRIBUTION_MINOR=500000000
# Where Paystack returns the customer after checkout.
PAYSTACK_CALLBACK_URL=http://localhost:5173/orders/callback
# Must be a currency your Paystack account is enabled for: NGN, GHS, ZAR, KES, USD.
CURRENCY=NGN
# Shipping in minor units of CURRENCY (defaults suit NGN: ₦2,500 flat, free over ₦50,000).
SHIPPING_FLAT_MINOR=250000
FREE_SHIPPING_THRESHOLD_MINOR=5000000

# Number of reverse proxies in front of this server (leave unset if none).
# Needed for the audit trail to record real client IPs rather than the proxy's.
# Do NOT set it without a proxy: X-Forwarded-For would then be client-controlled.
# TRUST_PROXY=1

# Ad rate card, in minor units per day, per placement. The price a launcher
# pays is derived from these on the server -- the browser never sends one.
# Defaults suit NGN: home ₦15,000/day, discover ₦10,000/day, board ₦8,000/day.
# AD_RATE_HOME_MINOR=1500000
# AD_RATE_DISCOVER_MINOR=1000000
# AD_RATE_BOARD_MINOR=800000
